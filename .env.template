# C3PO Environment Variables
# Copy to .env and fill in values. Never commit .env.
# Keys are registered in Code/.env.keys (master store).

# ── Voyage AI ──────────────────────────────────────────────────────────────
VOYAGE_API_KEY=

# ── Pinecone ───────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_C3PO_HOST=          # set after index is created

# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Cloudflare (for Worker deployment) ─────────────────────────────────────
# PI org account — token stored in ../protocol-institute/.env.keys as CLOUDFLARE_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=7e8c7969b2464d23795c555bc6a32af8
# CLOUDFLARE_API_TOKEN — use value from ../.env.keys (not stored here)

# ── Worker + MCP ───────────────────────────────────────────────────────────
ADMIN_KEY=                   # generate per security-policy.md
MCP_API_KEY=                 # generate per security-policy.md

# ── Protocolized Substack ──────────────────────────────────────────────────
SUBSTACK_EXPORT_DIR=         # path to unzipped export on local disk

# ── Discord — BOT 1: corpus ingest (REST poller, no gateway) ───────────────
#
# Pattern: ingest/sync_discord.py polls the REST API on a timer (via bin/daemon.py).
#          Reads channel history and writes chunks to Pinecone.
#          No WebSocket connection. No privileged intents. Does not post messages.
#
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=             # comma-separated channel IDs to harvest
DISCORD_SUMMARY_CHANNEL_ID=      # channel for run-summary posts (optional)
DISCORD_STAR_EMOJI=⭐             # emoji used for community starring (default ⭐)

# ── Discord — BOT 2: c3po chat interface (gateway bot, mention-based) ──────
#
# Pattern: bin/c3po_bot.py runs as a persistent gateway bot (WebSocket).
#          Responds to @c3po mentions by querying the Cloudflare Worker and
#          replying in a thread. Reads from Pinecone (via Worker) — writes nothing.
#          Requires Message Content Intent enabled in Discord Dev Portal.
#          Completely independent of BOT 1 — separate Discord app, separate token.
#
ORACLE_BOT_TOKEN=                # bot token for the c3po chat app
ORACLE_APPLICATION_ID=           # application ID (General Information tab)
ORACLE_PUBLIC_KEY=               # public key (General Information tab)
ORACLE_ROLE_ID=                  # managed role Discord auto-creates when bot joins
ORACLE_ALLOWED_CHANNEL_IDS=      # comma-separated channel IDs; empty = all channels
INTRODUCTIONS_CHANNEL_ID=        # channel ID of #introductions; leave 0/blank to disable
