# C3PO Environment Variables
# Copy to .env and fill in values. Never commit .env.
# Keys are registered in Code/.env.keys (master store).

# ── Voyage AI ──────────────────────────────────────────────────────────────
VOYAGE_API_KEY=

# ── Pinecone ───────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_C3PO_HOST=          # set after index is created

# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Cloudflare (for Worker deployment) ─────────────────────────────────────
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ── Discord listener (c3po_listener) ──────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=             # comma-separated channel IDs to harvest (whitelist)
DISCORD_SUMMARY_CHANNEL_ID=      # channel where the bot posts run summaries (optional)
DISCORD_STAR_EMOJI=⭐             # emoji used for community starring (default ⭐)

# ── Discord oracle (c3po_oracle) ───────────────────────────────────────────
# Separate Discord application from c3po_listener.
# Create at https://discord.com/developers/applications → Bot → copy token.
ORACLE_BOT_TOKEN=                # bot token for c3po_oracle application
ORACLE_APPLICATION_ID=           # application ID (General Information tab)
ORACLE_PUBLIC_KEY=               # public key (General Information tab, for sig verification)
ORACLE_ALLOWED_CHANNEL_IDS=      # comma-separated channel IDs; empty = all channels

# ── Protocolized Substack ──────────────────────────────────────────────────
SUBSTACK_EXPORT_DIR=          # path to unzipped export on local disk
